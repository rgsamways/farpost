DATABASE_URL=postgres://farpost:farpost@localhost:5435/farpost
PORT=3001
WEB_URL=http://localhost:3000

# better-auth — Robin provisions these directly, not fabricated placeholders.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Farpost <hello@farpost.ca>

# Production only (Railway) — leave unset locally. Enables better-auth's
# crossSubDomainCookies so the session cookie set by api.farpost.ca is
# visible to farpost.ca. Set to: .farpost.ca
COOKIE_DOMAIN=
